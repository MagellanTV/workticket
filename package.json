{
  "name": "workticket",
  "version": "1.0.0",
  "description": "Claude Code skill that drives the full development cycle from ticket to draft PR, with a zero-dependency installer.",
  "type": "module",
  "bin": {
    "workticket": "bin/workticket.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "setup": "node bin/workticket.mjs install",
    "init": "node bin/workticket.mjs init",
    "doctor": "node bin/workticket.mjs doctor",
    "test": "node scripts/test/run.mjs",
    "prepublishOnly": "node scripts/test/run.mjs"
  },
  "files": [
    "bin/",
    "scripts/*.mjs",
    "scripts/lib/",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "setup/",
    "phases/",
    "agents/",
    "integrations/",
    "templates/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softjuanm/workticket.git"
  },
  "homepage": "https://github.com/softjuanm/workticket#readme",
  "bugs": {
    "url": "https://github.com/softjuanm/workticket/issues"
  },
  "author": "Juan Manuel",
  "license": "MIT",
  "keywords": [
    "claude",
    "claude-code",
    "claude-skill",
    "skill",
    "workflow",
    "developer-tools",
    "jira",
    "linear",
    "pull-request",
    "code-review"
  ]
}
